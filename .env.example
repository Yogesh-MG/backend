# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL) - Optional, defaults to SQLite
DB_NAME=freshon_db
DB_USER=freshon_user
DB_PASSWORD=your-db-password

# Redis Configuration - Optional, defaults to in-memory
REDIS_HOST=localhost
REDIS_PORT=6379
USE_INMEMORY_CHANNELS=True

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ============================================
# AI / LLM Configuration (Moonshot AI - Kimi)
# ============================================
# Get your API key from: https://platform.moonshot.cn/
# Moonshot AI provides OpenAI-compatible API for Kimi models

LLM_API_KEY=your-moonshot-api-key-here
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.5

# Optional: Adjust response creativity and length
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096

# Alternative: Groq Configuration (if not using Moonshot)
# LLM_API_KEY=your-groq-api-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Alternative: OpenAI Configuration (if not using Moonshot)
# LLM_API_KEY=your-openai-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ============================================
# Web Push Notifications (VAPID)
# ============================================
WEBPUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
WEBPUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
WEBPUSH_VAPID_ADMIN_EMAIL=admin@freshon.in

# ============================================
# Firebase Cloud Messaging (FCM)
# ============================================
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json
# Or for Docker/containers:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# ============================================
# Petpooja Payroll API
# ============================================
# Base URL for Petpooja API
PETPOOJA_BASE_URL=https://api.petpooja.com/v1

# OAuth credentials (get from Petpooja developer portal)
PETPOOJA_CLIENT_ID=your-client-id
PETPOOJA_CLIENT_SECRET=your-client-secret

# ============================================
# ICICI Eazypay Payment Gateway
# ============================================
# Enable ICICI payments (set to True to enable)
ICICI_ENABLED=False

# Environment: UAT (sandbox) or PROD (production)
ICICI_ENV_TYPE=UAT

# Merchant Configuration
ICICI_MERCHANT_ID=your-merchant-id
ICICI_TERMINAL_ID=your-terminal-id
ICICI_SUB_MERCHANT_ID=your-sub-merchant-id

# API Credentials
ICICI_API_KEY=your-icici-api-key

# Keystore Configuration (PKCS#12)
# Path to the ClientPrivateKey.p12 file
ICICI_KEYSTORE_PATH=/path/to/ClientPrivateKey.p12
ICICI_KEYSTORE_PASSWORD=your-keystore-password
ICICI_KEYSTORE_ALIAS=ICICI
